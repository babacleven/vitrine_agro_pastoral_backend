{
  "kind": "collectionType",
  "collectionName": "produits",
  "info": {
    "singularName": "produit",
    "pluralName": "produits",
    "displayName": "Produit",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "nom": {
      "type": "string"
    },
    "descriptionLong": {
      "type": "blocks"
    },
    "imagePrincipale": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "prix": {
      "type": "decimal"
    },
    "categorie": {
      "type": "enumeration",
      "enum": [
        "Légume",
        "Viande",
        "Produit transformé",
        "Autre"
      ]
    },
    "disponibilite": {
      "type": "boolean"
    },
    "ddescriptionCourte": {
      "type": "string"
    },
    "activites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::activite.activite",
      "mappedBy": "produits"
    },
    "galerie": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::galerie.galerie",
      "inversedBy": "produits"
    }
  }
}
